# Compose project name. Docker Compose uses this to namespace containers,
# networks, and volumes. Must be unique across stacks on this host.
COMPOSE_PROJECT_NAME=playwright-mcp

# Hostname the caddy-docker-proxy label will serve on. Resolve this via
# wildcard CNAME on the LAN (e.g. *.l.supported.systems -> LAN host).
DOMAIN=playwright.example.l.supported.systems

# Host UID/GID the container runs as. Match these to the user who owns
# the project directory and ~/.cache/ms-playwright/ so bind-mounts stay
# readable. On most Linux workstations this is 1000/1000.
UID=1000
GID=1000

# Default headless mode for the server. Individual sessions can override
# per-call via browser_configure(headless: true|false).
HEADLESS=false
